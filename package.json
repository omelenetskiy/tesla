{
  "name": "drive-scope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "predev": "node scripts/build-assets.mjs --vendor-only",
    "prebuild": "node scripts/build-assets.mjs --vendor-only",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sync:key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/sync-virtual-key.mts",
    "check:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/check-deployment.mts",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/verify-tesla.mts",
    "telemetry:ingest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/ingest-fleet-telemetry.mts",
    "telemetry:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/test-fleet-telemetry-ingest.mts",
    "telemetry:backfill-history": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/backfill-history.mts",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "deploy:sync-only": "bash scripts/deploy.sh --skip-build",
    "git:init": "bash scripts/init-git.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-stately/utils": "^3.12.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@untitledui/icons": "^0.0.22",
    "input-otp": "^1.5.0",
    "maplibre-gl": "^6.7.0",
    "next": "^16.3.4",
    "postcss": "^8.5.28",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.1",
    "lucide-react": "^0.468.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.7.2"
  }
}
