# Supabase public client configuration (frontend-safe values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and Tesla Owner API configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TESLA_API_BASE_URL=https://owner-api.teslamotors.com
TESLA_TOKEN_ENCRYPTION_KEY=
COLLECTION_CRON_SECRET=

# Optional basemap override for the map component.
# Defaults to https://tiles.openfreemap.org/styles/positron (no key, no signup).
# Accepts a style URL or an inlined style JSON. The previous default hot-linked
# tile.openstreetmap.org, whose tile policy blocks app traffic — see
# components/map/map-view.tsx.
NEXT_PUBLIC_MAP_STYLE_URL=
