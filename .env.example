# Supabase public client configuration (frontend-safe values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and Tesla Owner API configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TESLA_API_BASE_URL=https://owner-api.teslamotors.com
TESLA_TOKEN_ENCRYPTION_KEY=
COLLECTION_CRON_SECRET=

# Optional basemap override for the map component.
# Defaults to https://tiles.openfreemap.org/styles/bright (no key, no signup).
# Accepts a style URL or an inlined style JSON. The previous default hot-linked
# tile.openstreetmap.org, whose tile policy blocks app traffic — see
# components/map/map-view.tsx.

# Tesla Fleet API (docs/TESLA_FLEET_MIGRATION_PLAN.md §4a).
# The region decides the API base URL *and* the token audience, so it must match the
# account, not the car's current location: na | eu | cn. There is no default — a wrong
# region yields a 403 that is indistinguishable from a scope problem.
# China needs a separate developer.tesla.cn app.
TESLA_FLEET_REGION=
TESLA_FLEET_CLIENT_ID=
TESLA_FLEET_CLIENT_SECRET=
# Must equal the value registered at developer.tesla.com character for character.
# Defaults to ${NEXT_PUBLIC_APP_URL}/api/fleet/callback when left empty.
TESLA_FLEET_REDIRECT_URI=
# The ES256 key pair is NOT used for tokens. It signs vehicle commands, which is P2.
# TESLA_FLEET_PRIVATE_KEY_PATH=
