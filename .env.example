# Supabase public client configuration (frontend-safe values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to encrypt stored Tesla tokens (AES-256-GCM helper)
TESLA_TOKEN_ENCRYPTION_KEY=

# Public app URL (used to derive default Fleet callback URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tesla Fleet API
# Region must match your Tesla developer app/account region: na | eu | cn
TESLA_FLEET_REGION=na
TESLA_FLEET_CLIENT_ID=
TESLA_FLEET_CLIENT_SECRET=
# Optional override. If empty, defaults to ${NEXT_PUBLIC_APP_URL}/api/fleet/callback
TESLA_FLEET_REDIRECT_URI=
# Optional scope override (space-separated). Leave empty for project defaults.
TESLA_FLEET_SCOPES=

# Application virtual key private key path
# Generate with: ./deploy/fleet-telemetry/make-key.sh
TESLA_FLEET_PRIVATE_KEY_PATH=./deploy/fleet-telemetry/keys/private.pem

# Optional basemap overrides
NEXT_PUBLIC_MAP_STYLE_URL_LIGHT=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_MAP_STYLE_URL=
