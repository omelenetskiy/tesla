set timeout 12
log_user 1
set proxycmd {ssh -i ~/.ssh/ssh-key-2026-09-13.key -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=20 -W %h:%p -p 443 ocid1.instanceconsoleconnection.oc1.eu-frankfurt-1.antheljt74jhmvycqurg27hkczcmahmq6jj4c4cmm4y4f2rmjw3ztlcngizq@instance-console.eu-frankfurt-1.oci.oraclecloud.com}
spawn ssh -tt -i ~/.ssh/ssh-key-2026-09-13.key -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=20 -o ProxyCommand=$proxycmd ocid1.instance.oc1.eu-frankfurt-1.antheljt74jhmvycjhj5ynqvga3sh7blyr2sff2lzjbi4pmsmsh37kc66y7q
after 1500
send -- "\r"
after 1000
send -- "\r"
expect {
  -re {login:\s*$} { send_user "SAW_LOGIN\n"; send -- "ubuntu\r"; exp_continue }
  -re {Password:\s*$} { send_user "SAW_PASSWORD\n"; send -- "\r"; exp_continue }
  -re {(incorrect|Login incorrect|Authentication failure)} { send_user "LOGIN_FAILED\n"; exit 2 }
  -re {(\$ |# )$} { send_user "LOGIN_OK\n"; send -- "whoami\rhostname\r"; exp_continue }
  eof {}
  timeout { send_user "TIMEOUT\n"; exit 3 }
}
