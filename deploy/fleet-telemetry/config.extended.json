{
  "hostname": "${TELEMETRY_HOST}",
  "port": 443,
  "gtw_addr": "localhost:9090",
  "log_level": "info",
  "log_streaming": true,
  "reliable_ack_sources": ["vehicle"],
  "rate_limit": {
    "enabled": true,
    "max_msgs_per_min": 100000
  },
  "tls": {
    "cert": "./certs/server.crt",
    "key": "./certs/server.key",
    "ca": "./certs/ca.crt"
  },
  "records": [
    {
      "record": "Trips",
      "interval_seconds": 1
    },
    {
      "record": "V",
      "fields": [
        {
          "name": "Timestamp",
          "interval_seconds": 1
        },
        {
          "name": "CreatedAt",
          "interval_seconds": 1
