server {
    listen 127.0.0.1:9443 ssl http2;
    server_name __APP_HOST__;

    ssl_certificate __APP_CERT__;
    ssl_certificate_key __APP_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /.well-known/appspecific/com.tesla.3p.public-key.pem {
        alias __PUBLIC_KEY_FILE__;
        default_type application/x-pem-file;
        add_header Cache-Control "public, max-age=300" always;
    }

    location / {
        proxy_pass __UPSTREAM_ORIGIN__;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;

        proxy_set_header Host __UPSTREAM_HOST__;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}


