map $ssl_preread_server_name $tesla_tls_upstream {
    __APP_HOST__ app_backend;
    __TELEMETRY_HOST__ telemetry_backend;
    default telemetry_backend;
}

upstream app_backend {
    server 127.0.0.1:9443;
}

upstream telemetry_backend {
    server 127.0.0.1:8443;
}

server {
    listen 443;
    proxy_pass $tesla_tls_upstream;
    ssl_preread on;
}

